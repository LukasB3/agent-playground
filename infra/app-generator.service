[Unit]
Description=App Generator orchestrator
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
User=appgen
Group=appgen
EnvironmentFile=/etc/app-generator/orchestrator.env
WorkingDirectory=/opt/app-generator/orchestrator
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning dist/main.js
Restart=on-failure
RestartSec=3

# The service has no Docker access. It starts job containers through sudo and
# the ag-sandbox launcher, so NoNewPrivileges and the options that imply it
# cannot be used here.
ProtectSystem=strict
ReadWritePaths=/var/lib/app-generator
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
